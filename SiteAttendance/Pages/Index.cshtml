@page
@model SiteAttendance.Pages.IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

<!-- Page Header -->
<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <h4 class="fw-bold mb-1" style="color: #0F2042;">Dashboard Pengawasan Absensi</h4>
        <div class="text-muted small">
            Manage Service SIG – Site Rembang &bull; Periode Aktif: <strong class="text-dark">@Model.Dashboard.ActivePeriodText</strong>
        </div>
    </div>
    <div class="d-flex align-items-center gap-2">
        <a asp-page="/Attendance/Create" class="btn btn-navy shadow-sm">
            <i data-lucide="plus" style="width: 16px; height: 16px;"></i>
            <span>Input Absensi Baru</span>
        </a>
        <a asp-page="/Reports/Index" asp-route-startDate="@Model.Dashboard.FilterStartDate.ToString("yyyy-MM-dd")" asp-route-endDate="@Model.Dashboard.FilterEndDate.ToString("yyyy-MM-dd")" class="btn btn-secondary-corporate shadow-sm">
            <i data-lucide="printer" style="width: 16px; height: 16px;"></i>
            <span>Cetak Laporan</span>
        </a>
    </div>
</div>

<!-- Filter Bar Card -->
<div class="card card-corporate mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-12 col-md-3 col-lg-2">
                <label class="form-label small text-muted mb-1 fw-semibold">Dari Tanggal</label>
                <input type="date" name="startDate" class="form-control form-control-sm" value="@Model.Dashboard.FilterStartDate.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-12 col-md-3 col-lg-2">
                <label class="form-label small text-muted mb-1 fw-semibold">Sampai Tanggal</label>
                <input type="date" name="endDate" class="form-control form-control-sm" value="@Model.Dashboard.FilterEndDate.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-12 col-md-3 col-lg-2">
                <label class="form-label small text-muted mb-1 fw-semibold">Filter Engineer</label>
                <select name="employeeId" class="form-select form-select-sm" asp-items="Model.EmployeeOptions">
                    <option value="">-- Semua Engineer --</option>
                </select>
            </div>
            <div class="col-12 col-md-3 col-lg-2">
                <label class="form-label small text-muted mb-1 fw-semibold">Filter Status</label>
                <select name="status" class="form-select form-select-sm">
                    <option value="">-- Semua Status --</option>
                    @foreach (var val in Enum.GetValues<AttendanceStatus>())
                    {
                        if (Model.Status == val)
                        {
                            <option value="@val" selected>@val</option>
                        }
                        else
                        {
                            <option value="@val">@val</option>
                        }
                    }
                </select>
            </div>
            <div class="col-12 col-md-4 col-lg-2">
                <label class="form-label small text-muted mb-1 fw-semibold">Cari Keterangan</label>
                <input type="text" name="search" class="form-control form-control-sm" placeholder="Kata kunci..." value="@Model.Search" />
            </div>
            <div class="col-12 col-md-8 col-lg-2 d-flex gap-2">
                <button type="submit" class="btn btn-navy btn-sm flex-grow-1">
                    <i data-lucide="filter" style="width: 14px; height: 14px;"></i>
                    <span>Filter</span>
                </button>
                <a asp-page="/Index" class="btn btn-secondary-corporate btn-sm" title="Reset Filter">
                    <i data-lucide="rotate-ccw" style="width: 14px; height: 14px;"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<!-- KPI Summary Cards -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-4 col-lg-2">
        <div class="stat-card">
            <div class="stat-label">Total Engineer</div>
            <div class="stat-value">@Model.Dashboard.TotalEngineers</div>
            <div class="stat-subtext">On Site Rembang</div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-lg-2">
        <div class="stat-card" style="border-left: 3px solid #10B981;">
            <div class="stat-label text-success">Total Hadir</div>
            <div class="stat-value text-success">@Model.Dashboard.TotalHadir</div>
            <div class="stat-subtext">@Model.Dashboard.TotalWorkHours.ToString("0.##") Total Jam</div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-lg-2">
        <div class="stat-card" style="border-left: 3px solid #F59E0B;">
            <div class="stat-label text-warning">Total Izin</div>
            <div class="stat-value text-warning">@Model.Dashboard.TotalIzin</div>
            <div class="stat-subtext">Disetujui</div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-lg-2">
        <div class="stat-card" style="border-left: 3px solid #EF4444;">
            <div class="stat-label text-danger">Total Sakit</div>
            <div class="stat-value text-danger">@Model.Dashboard.TotalSakit</div>
            <div class="stat-subtext">Surat Keterangan</div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-lg-2">
        <div class="stat-card" style="border-left: 3px solid #6366F1;">
            <div class="stat-label text-primary">Total Cuti</div>
            <div class="stat-value text-primary">@Model.Dashboard.TotalCuti</div>
            <div class="stat-subtext">Cuti Tahunan</div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-lg-2">
        <div class="stat-card" style="border-left: 3px solid #64748B;">
            <div class="stat-label text-secondary">Total Libur</div>
            <div class="stat-value text-secondary">@Model.Dashboard.TotalLibur</div>
            <div class="stat-subtext">Hari Libur / Weekend</div>
        </div>
    </div>
</div>

<!-- Engineer Presence Summary Section -->
<div class="row g-3 mb-4">
    @foreach (var emp in Model.Dashboard.EmployeeSummaries)
    {
        <div class="col-12 col-md-6">
            <div class="card card-corporate h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <div class="d-flex align-items-center gap-3">
                            <div class="user-avatar" style="width: 40px; height: 40px; font-size: 1rem;">
                                @emp.FullName.Substring(0, 1)
                            </div>
                            <div>
                                <h6 class="fw-bold mb-0 text-dark">@emp.FullName</h6>
                                <div class="text-muted small">@emp.EmployeeCode &bull; @emp.Position</div>
                            </div>
                        </div>
                        <span class="badge bg-light text-dark border px-2 py-1" style="font-size: 0.8rem;">
                            Tingkat Kehadiran: <strong>@emp.PresenceRate%</strong>
                        </span>
                    </div>

                    <div class="row g-2 text-center pt-2 border-top">
                        <div class="col-3">
                            <div class="small text-muted">Hadir</div>
                            <div class="fw-bold text-success fs-5">@emp.HadirCount</div>
                        </div>
                        <div class="col-3">
                            <div class="small text-muted">Izin/Sakit</div>
                            <div class="fw-bold text-warning fs-5">@(emp.IzinCount + emp.SakitCount)</div>
                        </div>
                        <div class="col-3">
                            <div class="small text-muted">Cuti</div>
                            <div class="fw-bold text-primary fs-5">@emp.CutiCount</div>
                        </div>
                        <div class="col-3">
                            <div class="small text-muted">Jam Kerja</div>
                            <div class="fw-bold text-dark fs-5">@emp.TotalHours.ToString("0.##") h</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- Main Row: Recent Activities & Audit Log -->
<div class="row g-3">
    <!-- Recent Attendance Table -->
    <div class="col-12 col-lg-8">
        <div class="card card-corporate">
            <div class="card-header">
                <h6 class="card-title d-flex align-items-center gap-2">
                    <i data-lucide="list" style="width: 18px; height: 18px; color: #0F2042;"></i>
                    <span>Aktivitas Absensi Terkini</span>
                </h6>
                <a asp-page="/Attendance/Index" class="btn btn-link btn-sm p-0 text-decoration-none fw-semibold" style="color: #0F2042;">Lihat Seluruh Data &rarr;</a>
            </div>
            <div class="table-responsive">
                <table class="table table-corporate align-middle">
                    <thead>
                        <tr>
                            <th>Tanggal</th>
                            <th>Engineer</th>
                            <th>Jam Kerja</th>
                            <th>Status</th>
                            <th>Keterangan</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Dashboard.RecentAttendances.Any())
                        {
                            @foreach (var att in Model.Dashboard.RecentAttendances)
                            {
                                <tr>
                                    <td class="fw-medium">@att.AttendanceDate.ToString("dd MMM yyyy")</td>
                                    <td>
                                        <div class="fw-bold text-dark">@att.Employee.FullName</div>
                                        <div class="text-muted" style="font-size: 0.72rem;">@att.Employee.EmployeeCode</div>
                                    </td>
                                    <td>
                                        @if (att.Status == AttendanceStatus.Hadir && att.CheckIn.HasValue && att.CheckOut.HasValue)
                                        {
                                            <span>@att.CheckIn.Value.ToString("HH:mm") - @att.CheckOut.Value.ToString("HH:mm")</span>
                                            <span class="text-muted small">(@att.TotalWorkHours.ToString("0.##") Jam)</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge-status badge-@att.Status.ToString().ToLowerInvariant()">
                                            @att.Status
                                        </span>
                                    </td>
                                    <td class="text-truncate" style="max-width: 200px;" title="@att.Description">
                                        @(string.IsNullOrWhiteSpace(att.Description) ? "-" : att.Description)
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted py-4">
                                    Belum ada data absensi pada periode ini.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- System Audit Log Sidebar -->
    <div class="col-12 col-lg-4">
        <div class="card card-corporate">
            <div class="card-header">
                <h6 class="card-title d-flex align-items-center gap-2">
                    <i data-lucide="history" style="width: 18px; height: 18px; color: #0F2042;"></i>
                    <span>Log Aktivitas Sistem</span>
                </h6>
            </div>
            <div class="card-body p-0">
                <ul class="list-group list-group-flush" style="font-size: 0.8rem;">
                    @if (Model.Dashboard.RecentAuditLogs.Any())
                    {
                        @foreach (var log in Model.Dashboard.RecentAuditLogs)
                        {
                            <li class="list-group-item p-3">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="badge bg-light text-dark border fw-bold" style="font-size: 0.68rem;">@log.Action</span>
                                    <span class="text-muted" style="font-size: 0.7rem;">@log.CreatedAt.AddHours(7).ToString("dd/MM HH:mm") WIB</span>
                                </div>
                                <div class="text-dark" style="font-size: 0.78rem; line-height: 1.3;">@log.Description</div>
                                <div class="text-muted mt-1" style="font-size: 0.68rem;">User: <strong>@(log.UserId ?? "SYSTEM")</strong></div>
                            </li>
                        }
                    }
                    else
                    {
                        <li class="list-group-item text-center text-muted py-3">Belum ada riwayat audit log.</li>
                    }
                </ul>
            </div>
        </div>
    </div>
</div>
