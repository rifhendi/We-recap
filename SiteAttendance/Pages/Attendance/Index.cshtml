@page
@model SiteAttendance.Pages.Attendance.IndexModel
@{
    ViewData["Title"] = "Data Absensi";
}

<!-- Header -->
<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <h4 class="fw-bold mb-1" style="color: #0F2042;">Pengelolaan Data Absensi</h4>
        <div class="text-muted small">
            Daftar absensi harian Engineer On Site &bull; Manage Service SIG Site Rembang
        </div>
    </div>
    <div class="d-flex flex-wrap align-items-center gap-2">
        <a asp-page="./Daily" class="btn btn-primary shadow-sm fw-semibold">
            <i data-lucide="check-square" style="width: 16px; height: 16px;"></i>
            <span>Input Harian Cepat</span>
        </a>
        <a asp-page="./Create" class="btn btn-navy shadow-sm">
            <i data-lucide="plus" style="width: 16px; height: 16px;"></i>
            <span>Catat Satuan</span>
        </a>
        <div class="dropdown">
            <button class="btn btn-secondary-corporate dropdown-toggle shadow-sm" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                <i data-lucide="download" style="width: 16px; height: 16px;"></i>
                <span>Export Laporan</span>
            </button>
            <ul class="dropdown-menu dropdown-menu-end shadow border-0" style="font-size: 0.85rem;">
                <li>
                    <a class="dropdown-item d-flex align-items-center gap-2" asp-page="/Reports/Index" asp-route-startDate="@Model.Filter.StartDate?.ToString("yyyy-MM-dd")" asp-route-endDate="@Model.Filter.EndDate?.ToString("yyyy-MM-dd")" asp-route-employeeId="@Model.Filter.EmployeeId" asp-route-handler="DownloadPdf">
                        <i data-lucide="file-text" style="width: 15px; height: 15px; color: #DC2626;"></i>
                        <span>Export PDF Resmi (A4)</span>
                    </a>
                </li>
                <li>
                    <a class="dropdown-item d-flex align-items-center gap-2" asp-page="/Reports/Index" asp-route-startDate="@Model.Filter.StartDate?.ToString("yyyy-MM-dd")" asp-route-endDate="@Model.Filter.EndDate?.ToString("yyyy-MM-dd")" asp-route-employeeId="@Model.Filter.EmployeeId" asp-route-handler="DownloadExcel">
                        <i data-lucide="file-spreadsheet" style="width: 15px; height: 15px; color: #059669;"></i>
                        <span>Export Excel (.xlsx)</span>
                    </a>
                </li>
                <li>
                    <a class="dropdown-item d-flex align-items-center gap-2" asp-page="/Reports/Index" asp-route-startDate="@Model.Filter.StartDate?.ToString("yyyy-MM-dd")" asp-route-endDate="@Model.Filter.EndDate?.ToString("yyyy-MM-dd")" asp-route-employeeId="@Model.Filter.EmployeeId" asp-route-handler="DownloadCsv">
                        <i data-lucide="file-code" style="width: 15px; height: 15px; color: #2563EB;"></i>
                        <span>Export CSV (.csv)</span>
                    </a>
                </li>
                <li><hr class="dropdown-divider"></li>
                <li>
                    <a class="dropdown-item d-flex align-items-center gap-2" asp-page="/Reports/Index" asp-route-startDate="@Model.Filter.StartDate?.ToString("yyyy-MM-dd")" asp-route-endDate="@Model.Filter.EndDate?.ToString("yyyy-MM-dd")" asp-route-employeeId="@Model.Filter.EmployeeId">
                        <i data-lucide="printer" style="width: 15px; height: 15px; color: #0F2042;"></i>
                        <span>Halaman Review & Tanda Tangan</span>
                    </a>
                </li>
            </ul>
        </div>
    </div>
</div>

<!-- Date Range & Criteria Filter Form -->
<div class="card card-corporate mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-12 col-md-3 col-lg-2">
                <label class="form-label small text-muted mb-1 fw-semibold">Dari Tanggal</label>
                <input type="date" name="StartDate" class="form-control form-control-sm" value="@Model.Filter.StartDate?.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-12 col-md-3 col-lg-2">
                <label class="form-label small text-muted mb-1 fw-semibold">Sampai Tanggal</label>
                <input type="date" name="EndDate" class="form-control form-control-sm" value="@Model.Filter.EndDate?.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-12 col-md-3 col-lg-2">
                <label class="form-label small text-muted mb-1 fw-semibold">Pilih Engineer</label>
                <select name="EmployeeId" class="form-select form-select-sm" asp-items="Model.EmployeeOptions">
                    <option value="">-- Semua Engineer --</option>
                </select>
            </div>
            <div class="col-12 col-md-3 col-lg-2">
                <label class="form-label small text-muted mb-1 fw-semibold">Status Kehadiran</label>
                <select name="Status" class="form-select form-select-sm">
                    <option value="">-- Semua Status --</option>
                    @foreach (var val in Enum.GetValues<AttendanceStatus>())
                    {
                        if (Model.Filter.Status == val)
                        {
                            <option value="@val" selected>@val</option>
                        }
                        else
                        {
                            <option value="@val">@val</option>
                        }
                    }
                </select>
            </div>
            <div class="col-12 col-md-4 col-lg-2">
                <label class="form-label small text-muted mb-1 fw-semibold">Pencarian</label>
                <input type="text" name="Search" class="form-control form-control-sm" placeholder="Nama / Keterangan..." value="@Model.Filter.Search" />
            </div>
            <div class="col-12 col-md-8 col-lg-2 d-flex gap-2">
                <button type="submit" class="btn btn-navy btn-sm flex-grow-1">
                    <i data-lucide="filter" style="width: 14px; height: 14px;"></i>
                    <span>Terapkan</span>
                </button>
                <a asp-page="./Index" class="btn btn-secondary-corporate btn-sm" title="Reset Filter">
                    <i data-lucide="rotate-ccw" style="width: 14px; height: 14px;"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Attendance Data Table -->
<div class="card card-corporate">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h6 class="card-title d-flex align-items-center gap-2">
            <i data-lucide="calendar" style="width: 18px; height: 18px; color: #0F2042;"></i>
            <span>Daftar Rekam Kehadiran (@Model.Attendances.Count Data Ditemukan)</span>
        </h6>
        <div class="text-muted small">
            Periode: <strong>@(Model.Filter.StartDate?.ToString("dd/MM/yyyy") ?? "-") s/d @(Model.Filter.EndDate?.ToString("dd/MM/yyyy") ?? "-")</strong>
        </div>
    </div>
    <div class="table-responsive">
        <table class="table table-corporate align-middle">
            <thead>
                <tr>
                    <th style="width: 50px;" class="text-center">No</th>
                    <th>Tanggal & Hari</th>
                    <th>Engineer</th>
                    <th>Jam Masuk</th>
                    <th>Jam Pulang</th>
                    <th class="text-center">Total Jam</th>
                    <th class="text-center">Status</th>
                    <th>Keterangan</th>
                    <th class="text-center" style="width: 120px;">Aksi</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Attendances.Any())
                {
                    int no = 1;
                    foreach (var item in Model.Attendances)
                    {
                        var dayName = AttendanceReportRow.GetIndonesianDay(item.AttendanceDate.DayOfWeek);
                        <tr>
                            <td class="text-center text-muted small">@(no++)</td>
                            <td>
                                <div class="fw-bold text-dark">@item.AttendanceDate.ToString("dd MMMM yyyy")</div>
                                <div class="text-muted small">@dayName</div>
                            </td>
                            <td>
                                <div class="fw-semibold text-dark">@item.Employee.FullName</div>
                                <div class="text-muted" style="font-size: 0.72rem;">@item.Employee.EmployeeCode &bull; @item.Employee.Position</div>
                            </td>
                            <td>
                                @if (item.CheckIn.HasValue)
                                {
                                    <span class="badge bg-light text-dark border font-monospace">@item.CheckIn.Value.ToString("HH:mm")</span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td>
                                @if (item.CheckOut.HasValue)
                                {
                                    <span class="badge bg-light text-dark border font-monospace">@item.CheckOut.Value.ToString("HH:mm")</span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td class="text-center">
                                @if (item.TotalWorkHours > 0)
                                {
                                    <span class="fw-bold text-dark">@item.TotalWorkHours.ToString("0.##")</span>
                                    <span class="text-muted small"> Jam</span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td class="text-center">
                                <span class="badge-status badge-@item.Status.ToString().ToLowerInvariant()">
                                    @item.Status
                                </span>
                            </td>
                            <td class="text-truncate" style="max-width: 240px;" title="@item.Description">
                                @(string.IsNullOrWhiteSpace(item.Description) ? "-" : item.Description)
                            </td>
                            <td class="text-center">
                                <div class="d-inline-flex gap-1">
                                    <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary p-1" title="Edit Data">
                                        <i data-lucide="pencil" style="width: 14px; height: 14px;"></i>
                                    </a>
                                    <button type="button" class="btn btn-sm btn-outline-danger p-1" title="Hapus Data"
                                            onclick="openDeleteModal(@item.Id, '@item.Employee.FullName', '@item.AttendanceDate.ToString("dd/MM/yyyy")')">
                                        <i data-lucide="trash-2" style="width: 14px; height: 14px;"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="9" class="text-center text-muted py-5">
                            <i data-lucide="calendar-x" class="d-block mx-auto mb-2 text-muted" style="width: 32px; height: 32px;"></i>
                            Tidak ada data absensi yang sesuai kriteria pencarian.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal Konfirmasi Hapus Data Absensi -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-danger text-white">
                <h6 class="modal-title fw-bold" id="deleteModalLabel">
                    <i data-lucide="alert-triangle" class="me-1" style="width: 18px; height: 18px;"></i>
                    Konfirmasi Hapus Absensi
                </h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4 text-center">
                <p class="mb-2">Apakah Anda yakin ingin menghapus data absensi ini?</p>
                <div class="alert alert-light border fw-semibold text-dark p-2" id="deleteTargetInfo"></div>
                <div class="text-muted small">Tindakan ini akan dicatat ke dalam Audit Log PostgreSQL.</div>
            </div>
            <div class="modal-footer bg-light p-2">
                <button type="button" class="btn btn-secondary-corporate btn-sm" data-bs-dismiss="modal">Batal</button>
                <form method="post" asp-page-handler="Delete" id="deleteForm">
                    <input type="hidden" name="id" id="deleteTargetId" value="" />
                    <button type="submit" class="btn btn-danger btn-sm">Ya, Hapus Data</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openDeleteModal(id, employeeName, date) {
            document.getElementById('deleteTargetId').value = id;
            document.getElementById('deleteTargetInfo').innerText = employeeName + ' — ' + date;
            const modal = new bootstrap.Modal(document.getElementById('deleteModal'));
            modal.show();
        }
    </script>
}

