@page
@model SiteAttendance.Pages.Attendance.DailyModel
@using SiteAttendance.Models
@{
    ViewData["Title"] = "Input Absensi Cepat Harian";
    var prevDate = Model.TargetDate.AddDays(-1).ToString("yyyy-MM-dd");
    var nextDate = Model.TargetDate.AddDays(1).ToString("yyyy-MM-dd");
    var todayDate = DateOnly.FromDateTime(DateTime.UtcNow.AddHours(7)).ToString("yyyy-MM-dd");
    var isToday = Model.TargetDate.ToString("yyyy-MM-dd") == todayDate;
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-10 col-xl-9">
        <!-- Date Navigation Bar -->
        <div class="card card-corporate mb-3 shadow-sm border-0">
            <div class="card-body p-3">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                    <div>
                        <div class="d-flex align-items-center gap-2">
                            <h5 class="fw-bold mb-0 text-navy" style="color: #0F2042;">
                                <i data-lucide="check-square" class="d-inline text-primary me-1" style="width: 20px; height: 20px;"></i>
                                Input Absensi Harian
                            </h5>
                            @if (isToday)
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle small">Hari Ini</span>
                            }
                        </div>
                        <div class="text-muted small mt-1">
                            @Model.IndonesianDayName, @Model.TargetDate.ToString("dd MMMM yyyy", new System.Globalization.CultureInfo("id-ID")) &bull; Site Rembang
                        </div>
                    </div>

                    <!-- Date Switcher Buttons -->
                    <div class="d-flex align-items-center gap-1">
                        <a asp-page="./Daily" asp-route-date="@prevDate" class="btn btn-outline-secondary btn-sm px-2" title="Hari Sebelumnya">
                            <i data-lucide="chevron-left" style="width: 16px; height: 16px;"></i>
                        </a>

                        <form method="get" class="d-inline">
                            <input type="date" name="date" class="form-control form-control-sm px-2 text-center" 
                                   value="@Model.TargetDate.ToString("yyyy-MM-dd")" onchange="this.form.submit()" 
                                   style="max-width: 135px; font-weight: 500;" />
                        </form>

                        <a asp-page="./Daily" asp-route-date="@nextDate" class="btn btn-outline-secondary btn-sm px-2" title="Hari Berikutnya">
                            <i data-lucide="chevron-right" style="width: 16px; height: 16px;"></i>
                        </a>

                        @if (!isToday)
                        {
                            <a asp-page="./Daily" asp-route-date="@todayDate" class="btn btn-navy btn-sm ms-1">
                                Hari Ini
                            </a>
                        }
                    </div>
                </div>

                <!-- Quick Batch Action Buttons -->
                <div class="mt-3 pt-2 border-top d-flex flex-wrap align-items-center gap-2">
                    <span class="text-muted small fw-semibold">Aksi Cepat 1-Klik:</span>
                    <button type="button" class="btn btn-sm btn-light border text-success fw-semibold" onclick="setAllNormal()">
                        <i data-lucide="check-check" style="width: 14px; height: 14px;"></i>
                        Hadir Normal Semua (07:00 - 17:00)
                    </button>
                    <button type="button" class="btn btn-sm btn-light border text-secondary fw-semibold" onclick="setAllLibur()">
                        <i data-lucide="coffee" style="width: 14px; height: 14px;"></i>
                        Libur Semua
                    </button>
                </div>
            </div>
        </div>

        <!-- Form Input per Engineer -->
        <form method="post" id="dailyForm">
            <input type="hidden" name="targetDate" value="@Model.TargetDate.ToString("yyyy-MM-dd")" />

            @for (int i = 0; i < Model.Entries.Count; i++)
            {
                var entry = Model.Entries[i];
                <div class="card card-corporate mb-3 shadow-sm border" id="card-@i">
                    <div class="card-header bg-white py-2 px-3 d-flex align-items-center justify-content-between border-bottom">
                        <div class="d-flex align-items-center gap-2">
                            <div class="rounded-circle bg-navy text-white d-flex align-items-center justify-content-center fw-bold" 
                                 style="width: 32px; height: 32px; font-size: 0.85rem; background-color: #0F2042;">
                                @entry.FullName.Substring(0, 1).ToUpper()
                            </div>
                            <div>
                                <div class="fw-bold text-dark" style="font-size: 0.95rem;">@entry.FullName</div>
                                <div class="text-muted" style="font-size: 0.72rem;">@entry.EmployeeCode &bull; @entry.Position</div>
                            </div>
                        </div>
                        <div>
                            @if (entry.IsAlreadyRecorded)
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle">
                                    <i data-lucide="check" style="width: 12px; height: 12px;"></i> Tercatat
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">
                                    Belum Diisi
                                </span>
                            }
                        </div>
                    </div>

                    <div class="card-body p-3">
                        <input type="hidden" name="Entries[@i].AttendanceId" value="@entry.AttendanceId" />
                        <input type="hidden" name="Entries[@i].EmployeeId" value="@entry.EmployeeId" />
                        <input type="hidden" name="Entries[@i].EmployeeCode" value="@entry.EmployeeCode" />
                        <input type="hidden" name="Entries[@i].FullName" value="@entry.FullName" />
                        <input type="hidden" name="Entries[@i].Position" value="@entry.Position" />

                        <!-- Status Selection (Touch-friendly Pills) -->
                        <div class="mb-3">
                            <label class="form-label small text-muted fw-semibold mb-2">Status Kehadiran</label>
                            <div class="d-flex flex-wrap gap-2 status-pill-group">
                                @foreach (AttendanceStatus st in Enum.GetValues(typeof(AttendanceStatus)))
                                {
                                    var isChecked = entry.Status == st;
                                    var radioId = $"status_{i}_{st}";
                                    <div class="flex-fill">
                                        <input type="radio" class="btn-check" name="Entries[@i].Status" id="@radioId" 
                                               value="@st" @(isChecked ? "checked" : "") onchange="handleStatusChange(@i, '@st')" />
                                        <label class="btn btn-outline-secondary w-100 text-center py-2 status-label" for="@radioId" style="font-size: 0.82rem;">
                                            @st
                                        </label>
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Time Inputs (Shown if Hadir) -->
                        <div class="row g-2 mb-3 time-container" id="time-container-@i" style="@(entry.Status == AttendanceStatus.Hadir ? "" : "display: none;")">
                            <div class="col-6">
                                <label class="form-label small text-muted fw-semibold mb-1">
                                    <i data-lucide="clock" style="width: 13px; height: 13px;"></i> Waktu Masuk
                                </label>
                                <input type="time" name="Entries[@i].CheckIn" id="checkin-@i" 
                                       class="form-control form-control-sm py-2" value="@entry.CheckIn" />
                            </div>
                            <div class="col-6">
                                <label class="form-label small text-muted fw-semibold mb-1">
                                    <i data-lucide="clock" style="width: 13px; height: 13px;"></i> Waktu Keluar
                                </label>
                                <input type="time" name="Entries[@i].CheckOut" id="checkout-@i" 
                                       class="form-control form-control-sm py-2" value="@entry.CheckOut" />
                            </div>
                        </div>

                        <!-- Description & Quick Chips -->
                        <div>
                            <label class="form-label small text-muted fw-semibold mb-1">Keterangan / Aktivitas Lapangan</label>
                            <input type="text" name="Entries[@i].Description" id="desc-@i" 
                                   class="form-control form-control-sm py-2 mb-2" 
                                   placeholder="Contoh: Monitoring AP CCR Rembang, Preventive maintenance switch..." 
                                   value="@entry.Description" />

                            <!-- Quick Preset Description Chips -->
                            <div class="d-flex flex-wrap gap-1">
                                <button type="button" class="btn btn-light btn-sm border py-0 px-2" style="font-size: 0.72rem;" 
                                        onclick="setDesc(@i, 'Monitoring jaringan AP CCR Rembang')">+ AP CCR Rembang</button>
                                <button type="button" class="btn btn-light btn-sm border py-0 px-2" style="font-size: 0.72rem;" 
                                        onclick="setDesc(@i, 'Preventive maintenance Switch Rack')">+ Switch Rack</button>
                                <button type="button" class="btn btn-light btn-sm border py-0 px-2" style="font-size: 0.72rem;" 
                                        onclick="setDesc(@i, 'Troubleshooting koneksi Wi-Fi')">+ Wi-Fi Problem</button>
                                <button type="button" class="btn btn-light btn-sm border py-0 px-2" style="font-size: 0.72rem;" 
                                        onclick="setDesc(@i, 'Standby operasional Manage Service SIG')">+ Standby MS SIG</button>
                                <button type="button" class="btn btn-light btn-sm border py-0 px-2" style="font-size: 0.72rem;" 
                                        onclick="setDesc(@i, 'Pulang Cepat (Keperluan keluarga)')">+ Pulang Cepat</button>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <!-- Bottom Action Submit Bar (Sticky on Mobile) -->
            <div class="card card-corporate border shadow-sm sticky-bottom-bar mb-4">
                <div class="card-body p-3 d-flex flex-wrap align-items-center justify-content-between gap-2">
                    <div class="small text-muted d-none d-sm-block">
                        Pastikan data jam kerja dan status telah sesuai sebelum menyimpan ke database cloud Supabase.
                    </div>
                    <button type="submit" class="btn btn-navy btn-lg w-100 w-sm-auto px-4 py-2 d-flex align-items-center justify-content-center gap-2 shadow">
                        <i data-lucide="save" style="width: 18px; height: 18px;"></i>
                        <span>Simpan Semua Absensi Hari Ini</span>
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

<style>
    .status-pill-group .btn-outline-secondary {
        border-color: #E2E8F0;
        background-color: #F8FAFC;
        color: #334155;
        font-weight: 500;
        border-radius: 6px;
    }
    .status-pill-group .btn-check:checked + .btn-outline-secondary {
        background-color: #0F2042;
        border-color: #0F2042;
        color: #FFFFFF;
        font-weight: 600;
    }
    .sticky-bottom-bar {
        position: sticky;
        bottom: 1rem;
        z-index: 990;
        background-color: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(8px);
    }
    @@media (max-width: 767.98px) {
        .sticky-bottom-bar {
            bottom: 68px; /* Di atas mobile bottom navigation bar */
        }
    }
</style>

@section Scripts {
    <script>
        function handleStatusChange(index, status) {
            const timeContainer = document.getElementById('time-container-' + index);
            const checkInInput = document.getElementById('checkin-' + index);
            const checkOutInput = document.getElementById('checkout-' + index);

            if (status === 'Hadir') {
                timeContainer.style.display = 'flex';
                if (!checkInInput.value) checkInInput.value = '07:00';
                if (!checkOutInput.value) checkOutInput.value = '17:00';
            } else {
                timeContainer.style.display = 'none';
            }
        }

        function setDesc(index, text) {
            const input = document.getElementById('desc-' + index);
            if (input) {
                input.value = text;
            }
        }

        function setAllNormal() {
            const count = @Model.Entries.Count;
            for (let i = 0; i < count; i++) {
                const radioHadir = document.getElementById('status_' + i + '_Hadir');
                if (radioHadir) {
                    radioHadir.checked = true;
                    handleStatusChange(i, 'Hadir');
                }
                const checkInInput = document.getElementById('checkin-' + i);
                const checkOutInput = document.getElementById('checkout-' + i);
                if (checkInInput) checkInInput.value = '07:00';
                if (checkOutInput) checkOutInput.value = '17:00';
            }
        }

        function setAllLibur() {
            const count = @Model.Entries.Count;
            for (let i = 0; i < count; i++) {
                const radioLibur = document.getElementById('status_' + i + '_Libur');
                if (radioLibur) {
                    radioLibur.checked = true;
                    handleStatusChange(i, 'Libur');
                }
                const descInput = document.getElementById('desc-' + i);
                if (descInput && !descInput.value) {
                    descInput.value = 'Hari Libur Reguler';
                }
            }
        }
    </script>
}

