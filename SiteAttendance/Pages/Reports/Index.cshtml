@page
@model SiteAttendance.Pages.Reports.IndexModel
@{
    ViewData["Title"] = "Laporan Absensi Formal";
}

<!-- Action Toolbar (Hidden during print) -->
<div class="d-print-none mb-4">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3">
        <div>
            <h4 class="fw-bold mb-1" style="color: #0F2042;">Laporan Absensi Engineer On Site</h4>
            <div class="text-muted small">
                Manage Service SIG Site Rembang &bull; Dokumen Resmi Siap Cetak (A4)
            </div>
        </div>
        <div class="d-flex flex-wrap align-items-center gap-2">
            <a asp-page-handler="DownloadPdf"
               asp-route-startDate="@Model.StartDate?.ToString("yyyy-MM-dd")"
               asp-route-endDate="@Model.EndDate?.ToString("yyyy-MM-dd")"
               asp-route-employeeId="@Model.EmployeeId"
               class="btn btn-danger btn-sm d-inline-flex align-items-center gap-1 shadow-sm">
                <i data-lucide="file-text" style="width: 15px; height: 15px;"></i>
                <span>Download PDF Resmi (A4)</span>
            </a>

            <a asp-page-handler="DownloadExcel"
               asp-route-startDate="@Model.StartDate?.ToString("yyyy-MM-dd")"
               asp-route-endDate="@Model.EndDate?.ToString("yyyy-MM-dd")"
               asp-route-employeeId="@Model.EmployeeId"
               class="btn btn-success btn-sm d-inline-flex align-items-center gap-1 shadow-sm">
                <i data-lucide="file-spreadsheet" style="width: 15px; height: 15px;"></i>
                <span>Download Excel (.xlsx)</span>
            </a>

            <a asp-page-handler="DownloadCsv"
               asp-route-startDate="@Model.StartDate?.ToString("yyyy-MM-dd")"
               asp-route-endDate="@Model.EndDate?.ToString("yyyy-MM-dd")"
               asp-route-employeeId="@Model.EmployeeId"
               class="btn btn-outline-secondary btn-sm d-inline-flex align-items-center gap-1 shadow-sm">
                <i data-lucide="file-code" style="width: 15px; height: 15px;"></i>
                <span>Download CSV</span>
            </a>

            <button type="button" onclick="window.print()" class="btn btn-secondary-corporate btn-sm d-inline-flex align-items-center gap-1 shadow-sm">
                <i data-lucide="printer" style="width: 15px; height: 15px;"></i>
                <span>Cetak / Print</span>
            </button>
        </div>
    </div>

    <!-- Filter Bar Card -->
    <div class="card card-corporate">
        <div class="card-body p-3">
            <form method="get" class="row g-2 align-items-end">
                <div class="col-12 col-md-3">
                    <label class="form-label small text-muted mb-1 fw-semibold">Dari Tanggal</label>
                    <input type="date" name="startDate" class="form-control form-control-sm" value="@Model.StartDate?.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-12 col-md-3">
                    <label class="form-label small text-muted mb-1 fw-semibold">Sampai Tanggal</label>
                    <input type="date" name="endDate" class="form-control form-control-sm" value="@Model.EndDate?.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-12 col-md-4">
                    <label class="form-label small text-muted mb-1 fw-semibold">Pilih Engineer (Per-Engineer atau Semua)</label>
                    <select name="employeeId" class="form-select form-select-sm" asp-items="Model.EmployeeOptions">
                        <option value="">-- Semua Engineer (Gabungan) --</option>
                    </select>
                </div>
                <div class="col-12 col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-navy btn-sm flex-grow-1">
                        <i data-lucide="filter" style="width: 14px; height: 14px;"></i>
                        <span>Perbarui</span>
                    </button>
                    <a asp-page="./Index" class="btn btn-secondary-corporate btn-sm" title="Reset">
                        <i data-lucide="rotate-ccw" style="width: 14px; height: 14px;"></i>
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Formal Printable A4 Document Sheet -->
<div class="document-sheet shadow-sm bg-white p-4 p-md-5 mx-auto border" style="max-width: 900px; color: #1E293B;">
    <!-- Document Header -->
    <div class="d-flex justify-content-between align-items-start border-bottom pb-3 mb-3" style="border-bottom-width: 2px !important; border-bottom-color: #0F2042 !important;">
        <div>
            <h6 class="fw-bold mb-0 text-uppercase" style="color: #0F2042; font-size: 0.95rem; letter-spacing: 0.02em;">PT SEMEN GRESIK (PERSERO) TBK.</h6>
            <div class="fw-semibold text-dark small">MANAGE SERVICE SIG - SITE REMBANG</div>
            <div class="text-muted" style="font-size: 0.72rem;">Jln. Raya Rembang - Blora KM 17, Rembang, Jawa Tengah</div>
        </div>
        <div class="text-end">
            <div class="badge bg-light text-dark border px-2 py-1 mb-1 font-monospace" style="font-size: 0.75rem;">FORM ABSENSI</div>
            <div class="text-muted" style="font-size: 0.72rem;">Periode: @Model.Report.PeriodText</div>
        </div>
    </div>

    <!-- Document Title -->
    <div class="text-center my-4">
        <h5 class="fw-bold text-uppercase mb-1" style="color: #0F2042; letter-spacing: 0.05em;">ABSENSI ENGINEER ON SITE</h5>
        <div class="fw-semibold text-secondary text-uppercase small">MANAGE SERVICE SIG</div>
        <div class="text-muted small mt-1">
            Lokasi: <strong>@Model.Report.Location</strong> &bull; Periode: <strong>@Model.Report.PeriodText</strong>
        </div>
    </div>

    <!-- Sections per Engineer -->
    @foreach (var sec in Model.Report.Sections)
    {
        <div class="mb-4">
            <!-- Engineer Header Bar -->
            <div class="p-2 px-3 text-white d-flex justify-content-between align-items-center" style="background-color: #0F2042; border-radius: 4px;">
                <div class="small fw-bold">
                    Engineer: @sec.Employee.FullName (@sec.Employee.EmployeeCode) &bull; @sec.Employee.Position
                </div>
                <div class="small">
                    Total Hadir: <strong>@sec.HadirCount</strong> Hari &bull; <strong>@sec.TotalHours.ToString("0.##")</strong> Jam
                </div>
            </div>

            <!-- Table -->
            <div class="table-responsive mt-1">
                <table class="table table-bordered table-sm align-middle" style="font-size: 0.78rem; border-color: #CBD5E1;">
                    <thead class="table-light text-center" style="font-size: 0.72rem; text-transform: uppercase;">
                        <tr>
                            <th style="width: 35px;">No</th>
                            <th style="width: 95px;">Tanggal</th>
                            <th style="width: 75px;">Hari</th>
                            <th style="width: 80px;">Jam Masuk</th>
                            <th style="width: 80px;">Jam Pulang</th>
                            <th style="width: 75px;">Jam (H)</th>
                            <th style="width: 75px;">Status</th>
                            <th>Keterangan</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (sec.Rows.Any())
                        {
                            foreach (var r in sec.Rows)
                            {
                                <tr>
                                    <td class="text-center text-muted">@r.No</td>
                                    <td class="text-center font-monospace">@r.Date.ToString("dd/MM/yyyy")</td>
                                    <td class="text-center">@r.DayName</td>
                                    <td class="text-center font-monospace">@r.CheckInText</td>
                                    <td class="text-center font-monospace">@r.CheckOutText</td>
                                    <td class="text-center">@(r.WorkHours > 0 ? r.WorkHours.ToString("0.##") : "-")</td>
                                    <td class="text-center">
                                        <span class="badge-status badge-@r.Status.ToString().ToLowerInvariant()" style="font-size: 0.7rem; padding: 0.15rem 0.4rem;">
                                            @r.Status
                                        </span>
                                    </td>
                                    <td>@r.Description</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center text-muted py-3">Tidak ada catatan absensi untuk periode ini.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <!-- Summary Box -->
    <div class="card bg-light border p-3 mb-4" style="border-color: #CBD5E1 !important;">
        <div class="row align-items-center">
            <div class="col-12 col-md-8">
                <div class="fw-bold small text-uppercase" style="color: #0F2042;">Rekapitulasi Kehadiran:</div>
                <div class="small text-muted mt-1">
                    Total Hadir: <strong class="text-success">@Model.Report.TotalHadir</strong> Hari &bull;
                    Izin: <strong class="text-warning">@Model.Report.TotalIzin</strong> &bull;
                    Sakit: <strong class="text-danger">@Model.Report.TotalSakit</strong> &bull;
                    Cuti: <strong class="text-primary">@Model.Report.TotalCuti</strong> &bull;
                    Libur: <strong>@Model.Report.TotalLibur</strong>
                </div>
            </div>
            <div class="col-12 col-md-4 text-md-end mt-2 mt-md-0">
                <div class="fw-bold small" style="color: #0F2042;">Total Jam Kerja: @Model.Report.TotalWorkHours.ToString("0.##") Jam</div>
                <div class="text-muted" style="font-size: 0.7rem;">Dicetak: @DateTime.UtcNow.AddHours(7).ToString("dd/MM/yyyy HH:mm") WIB</div>
            </div>
        </div>
    </div>

    <!-- Formal Signature Section (Three Blocks with Manual Signature Space) -->
    <div class="mt-5 pt-3">
        <div class="row text-center g-3">
            <!-- 1. DIBUAT OLEH -->
            <div class="col-4">
                <div class="p-3 border rounded h-100 d-flex flex-column justify-content-between" style="border-color: #CBD5E1 !important; background-color: #FAFBFD;">
                    <div class="fw-bold small text-uppercase" style="color: #0F2042;">@Model.Report.CreatedBy.Header</div>
                    <div style="height: 65px;" class="d-flex align-items-center justify-content-center text-muted">
                        <!-- Ruang kosong tanda tangan fisik -->
                    </div>
                    <div>
                        <div class="fw-bold text-dark text-decoration-underline" style="font-size: 0.85rem;">@Model.Report.CreatedBy.Name</div>
                        <div class="text-muted" style="font-size: 0.7rem;">@Model.Report.CreatedBy.Title</div>
                    </div>
                </div>
            </div>

            <!-- 2. MENGETAHUI -->
            <div class="col-4">
                <div class="p-3 border rounded h-100 d-flex flex-column justify-content-between" style="border-color: #CBD5E1 !important; background-color: #FAFBFD;">
                    <div class="fw-bold small text-uppercase" style="color: #0F2042;">@Model.Report.AcknowledgedBy.Header</div>
                    <div style="height: 65px;" class="d-flex align-items-center justify-content-center text-muted">
                        <!-- Ruang kosong tanda tangan fisik -->
                    </div>
                    <div>
                        <div class="fw-bold text-dark text-decoration-underline" style="font-size: 0.85rem;">@Model.Report.AcknowledgedBy.Name</div>
                        <div class="text-muted" style="font-size: 0.7rem;">@Model.Report.AcknowledgedBy.Title</div>
                    </div>
                </div>
            </div>

            <!-- 3. MENYETUJUI -->
            <div class="col-4">
                <div class="p-3 border rounded h-100 d-flex flex-column justify-content-between" style="border-color: #CBD5E1 !important; background-color: #FAFBFD;">
                    <div class="fw-bold small text-uppercase" style="color: #0F2042;">@Model.Report.ApprovedBy.Header</div>
                    <div style="height: 65px;" class="d-flex align-items-center justify-content-center text-muted">
                        <!-- Ruang kosong tanda tangan fisik -->
                    </div>
                    <div>
                        <div class="fw-bold text-dark text-decoration-underline" style="font-size: 0.85rem;">@Model.Report.ApprovedBy.Name</div>
                        <div class="text-muted" style="font-size: 0.7rem; white-space: pre-line;">@Model.Report.ApprovedBy.Title</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    @@media print {
        body {
            background-color: #FFFFFF !important;
        }
        .app-sidebar, .app-topbar, footer, .d-print-none {
            display: none !important;
        }
        .app-main {
            margin-left: 0 !important;
        }
        .app-content {
            padding: 0 !important;
        }
        .document-sheet {
            border: none !important;
            box-shadow: none !important;
            padding: 0 !important;
            max-width: 100% !important;
        }
    }
</style>
