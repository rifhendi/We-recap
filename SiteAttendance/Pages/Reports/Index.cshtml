@page
@model SiteAttendance.Pages.Reports.IndexModel
@{
    ViewData["Title"] = "Laporan Absensi Engineer On Site";
}

<!-- Action Toolbar (Hidden during print) -->
<div class="d-print-none mb-4">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3">
        <div>
            <h4 class="fw-bold mb-1" style="color: #0F2042;">Laporan Absensi Engineer On Site</h4>
            <div class="text-muted small">
                Manage Service SIG Site Rembang &bull; Template Resmi PT Semen Gresik / SIG (A4)
            </div>
        </div>
        <div class="d-flex flex-wrap align-items-center gap-2">
            <a asp-page-handler="DownloadPdf"
               asp-route-startDate="@Model.StartDate?.ToString("yyyy-MM-dd")"
               asp-route-endDate="@Model.EndDate?.ToString("yyyy-MM-dd")"
               asp-route-employeeId="@Model.EmployeeId"
               class="btn btn-danger btn-sm d-inline-flex align-items-center gap-1 shadow-sm">
                <i data-lucide="file-text" style="width: 15px; height: 15px;"></i>
                <span>Download PDF Resmi (A4)</span>
            </a>

            <a asp-page-handler="DownloadExcel"
               asp-route-startDate="@Model.StartDate?.ToString("yyyy-MM-dd")"
               asp-route-endDate="@Model.EndDate?.ToString("yyyy-MM-dd")"
               asp-route-employeeId="@Model.EmployeeId"
               class="btn btn-success btn-sm d-inline-flex align-items-center gap-1 shadow-sm">
                <i data-lucide="file-spreadsheet" style="width: 15px; height: 15px;"></i>
                <span>Download Excel (.xlsx)</span>
            </a>

            <a asp-page-handler="DownloadCsv"
               asp-route-startDate="@Model.StartDate?.ToString("yyyy-MM-dd")"
               asp-route-endDate="@Model.EndDate?.ToString("yyyy-MM-dd")"
               asp-route-employeeId="@Model.EmployeeId"
               class="btn btn-outline-secondary btn-sm d-inline-flex align-items-center gap-1 shadow-sm">
                <i data-lucide="file-code" style="width: 15px; height: 15px;"></i>
                <span>Download CSV</span>
            </a>

            <button type="button" onclick="window.print()" class="btn btn-secondary-corporate btn-sm d-inline-flex align-items-center gap-1 shadow-sm">
                <i data-lucide="printer" style="width: 15px; height: 15px;"></i>
                <span>Cetak / Print</span>
            </button>
        </div>
    </div>

    <!-- Filter Bar Card -->
    <div class="card card-corporate">
        <div class="card-body p-3">
            <form method="get" class="row g-2 align-items-end">
                <div class="col-12 col-md-3">
                    <label class="form-label small text-muted mb-1 fw-semibold">Dari Tanggal</label>
                    <input type="date" name="startDate" class="form-control form-control-sm" value="@Model.StartDate?.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-12 col-md-3">
                    <label class="form-label small text-muted mb-1 fw-semibold">Sampai Tanggal</label>
                    <input type="date" name="endDate" class="form-control form-control-sm" value="@Model.EndDate?.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-12 col-md-4">
                    <label class="form-label small text-muted mb-1 fw-semibold">Pilih Engineer (Per-Engineer atau Semua)</label>
                    <select name="employeeId" class="form-select form-select-sm" asp-items="Model.EmployeeOptions">
                        <option value="">-- Semua Engineer (Gabungan) --</option>
                    </select>
                </div>
                <div class="col-12 col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-navy btn-sm flex-grow-1">
                        <i data-lucide="filter" style="width: 14px; height: 14px;"></i>
                        <span>Terapkan</span>
                    </button>
                    <a asp-page="./Index" class="btn btn-secondary-corporate btn-sm" title="Reset">
                        <i data-lucide="rotate-ccw" style="width: 14px; height: 14px;"></i>
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Formal Printable A4 Document Sheet -->
@foreach (var sec in Model.Report.Sections)
{
    <div class="document-sheet shadow bg-white p-4 p-md-5 mx-auto border mb-5" style="max-width: 920px; color: #000; font-family: Arial, sans-serif;">
        <!-- Header: Logos and Title -->
        <div class="d-flex justify-content-between align-items-center mb-3">
            <!-- Left: KIRANA Logo -->
            <div style="width: 140px;">
                <img src="/images/logo-kirana.png?v=2" alt="Logo Kirana" style="height: 44px; max-width: 100%; object-fit: contain;" />
            </div>

            <!-- Center: Title -->
            <div class="text-center flex-grow-1 px-2">
                <h6 class="fw-bold text-uppercase mb-1" style="font-size: 1.05rem; letter-spacing: 0.04em; color: #000;">
                    ABSENSI ENGINEER ON SITE
                </h6>
                <h6 class="fw-bold text-uppercase mb-0" style="font-size: 1rem; color: #000;">
                    MANAGE SERVICE SIG
                </h6>
            </div>

            <!-- Right: SIG Logo -->
            <div style="width: 140px;" class="text-end">
                <img src="/images/logo-sig.png?v=2" alt="Logo SIG" style="height: 44px; max-width: 100%; object-fit: contain;" />
            </div>
        </div>

        <!-- Metadata Section (Nama, Periode, Lokasi) -->
        <div class="mb-3" style="font-size: 0.85rem; line-height: 1.6;">
            <div class="d-flex">
                <div style="width: 75px;">Nama</div>
                <div style="width: 15px;">:</div>
                <div class="fw-bold">@sec.Employee.FullName</div>
            </div>
            <div class="d-flex">
                <div style="width: 75px;">Periode</div>
                <div style="width: 15px;">:</div>
                <div>@Model.Report.PeriodText</div>
            </div>
            <div class="d-flex">
                <div style="width: 75px;">Lokasi</div>
                <div style="width: 15px;">:</div>
                <div>@Model.Report.Location</div>
            </div>
        </div>

        <!-- Attendance Table -->
        <div class="table-responsive">
            <table class="table table-bordered table-sm align-middle mb-4" style="border: 1px solid #000; font-size: 0.78rem;">
                <thead class="text-center" style="border-bottom: 1.5px solid #000;">
                    <tr style="background-color: #F8FAFC;">
                        <th style="width: 38px; border: 1px solid #000;">No</th>
                        <th style="width: 145px; border: 1px solid #000;">Tanggal</th>
                        <th style="width: 85px; border: 1px solid #000;">Hari</th>
                        <th style="width: 95px; border: 1px solid #000;">Waktu Masuk</th>
                        <th style="width: 95px; border: 1px solid #000;">Waktu Keluar</th>
                        <th class="text-start" style="border: 1px solid #000;">Keterangan</th>
                    </tr>
                </thead>
                <tbody>
                    @if (sec.Rows.Any())
                    {
                        foreach (var r in sec.Rows)
                        {
                            <tr>
                                <td class="text-center" style="border: 1px solid #000;">@r.No</td>
                                <td class="text-center" style="border: 1px solid #000;">@r.FormattedDate</td>
                                <td class="text-center" style="border: 1px solid #000;">@r.DayName</td>
                                <td class="text-center" style="border: 1px solid #000;">@r.CheckInText</td>
                                <td class="text-center" style="border: 1px solid #000;">@r.CheckOutText</td>
                                <td class="text-start" style="border: 1px solid #000;">@r.Description</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-3" style="border: 1px solid #000;">Tidak ada catatan absensi untuk periode ini.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Signatures (3 Columns) -->
        <div class="row text-center mt-4 pt-2 g-2" style="font-size: 0.82rem;">
            <!-- 1. DIBUAT OLEH -->
            <div class="col-4">
                <div>@sec.CreatedBy.Header</div>
                <div class="fw-bold">@sec.CreatedBy.Company</div>
                <div style="height: 60px;"></div>
                <div class="fw-bold">@sec.CreatedBy.Name</div>
                <div class="small">@sec.CreatedBy.Title</div>
            </div>

            <!-- 2. MENGETAHUI -->
            <div class="col-4">
                <div>@Model.Report.AcknowledgedBy.Header</div>
                <div class="fw-bold">@Model.Report.AcknowledgedBy.Company</div>
                <div style="height: 60px;"></div>
                <div class="fw-bold">@Model.Report.AcknowledgedBy.Name</div>
                <div class="small">@Model.Report.AcknowledgedBy.Title</div>
            </div>

            <!-- 3. MENYETUJUI -->
            <div class="col-4">
                <div>@Model.Report.ApprovedBy.Header</div>
                <div class="fw-bold">@Model.Report.ApprovedBy.Company</div>
                <div style="height: 60px;"></div>
                <div class="fw-bold">@Model.Report.ApprovedBy.Name</div>
                <div class="small">@Model.Report.ApprovedBy.Title</div>
            </div>
        </div>
    </div>
}

<style>
    @@media print {
        body {
            background-color: #FFFFFF !important;
            margin: 0 !important;
            padding: 0 !important;
        }
        .app-sidebar, .app-topbar, footer, .d-print-none {
            display: none !important;
        }
        .app-main {
            margin-left: 0 !important;
            padding: 0 !important;
        }
        .app-content {
            padding: 0 !important;
        }
        .document-sheet {
            border: none !important;
            box-shadow: none !important;
            padding: 0 !important;
            margin: 0 !important;
            max-width: 100% !important;
            page-break-after: always;
        }
        .document-sheet:last-child {
            page-break-after: auto;
        }
    }
</style>
