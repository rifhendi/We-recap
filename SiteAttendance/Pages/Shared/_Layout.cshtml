@using Microsoft.AspNetCore.Identity
@using SiteAttendance.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@{
    var currentPath = Context.Request.Path.Value ?? "/";
    var currentUser = await UserManager.GetUserAsync(User);
    var displayName = currentUser?.FullName ?? User.Identity?.Name ?? "Vino Rifhendi Setiawan";
}
<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>@ViewData["Title"] - Site Attendance Management</title>
    <meta name="theme-color" content="#0F2042" />
    <link rel="icon" type="image/png" href="~/images/logo-kirana.png" />
    <link rel="manifest" href="~/manifest.json" />
    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <!-- Site CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
</head>
<body>
    @if (SignInManager.IsSignedIn(User))
    {
        <!-- Sidebar Navigation -->
        <aside class="app-sidebar" id="appSidebar">
            <div class="sidebar-header d-flex justify-content-between align-items-center">
                <div>
                    <div class="sidebar-brand-title">SITE ATTENDANCE</div>
                    <div class="sidebar-brand-sub">Manage Service SIG</div>
                </div>
                <button type="button" class="btn btn-sm text-white d-lg-none p-1" id="sidebarCloseBtn">
                    <i data-lucide="x" style="width: 20px; height: 20px;"></i>
                </button>
            </div>

            <nav class="sidebar-nav">
                <div class="nav-section-title">Menu Utama</div>
                <a class="sidebar-link @(currentPath == "/" || currentPath == "/Index" ? "active" : "")" asp-page="/Index">
                    <i data-lucide="layout-dashboard" style="width: 18px; height: 18px;"></i>
                    <span>Dashboard</span>
                </a>

                <a class="sidebar-link @(currentPath.StartsWith("/Attendance/Daily") ? "active" : "")" asp-page="/Attendance/Daily">
                    <i data-lucide="check-square" style="width: 18px; height: 18px;"></i>
                    <span>Input Harian Cepat</span>
                    <span class="badge bg-primary ms-auto" style="font-size: 0.65rem;">Cepat</span>
                </a>

                <a class="sidebar-link @(currentPath == "/Attendance" || (currentPath.StartsWith("/Attendance") && !currentPath.StartsWith("/Attendance/Daily")) ? "active" : "")" asp-page="/Attendance/Index">
                    <i data-lucide="calendar-check" style="width: 18px; height: 18px;"></i>
                    <span>Data Absensi (CRUD)</span>
                </a>

                <a class="sidebar-link @(currentPath.StartsWith("/Employees") ? "active" : "")" asp-page="/Employees/Index">
                    <i data-lucide="users" style="width: 18px; height: 18px;"></i>
                    <span>Kelola Engineer</span>
                </a>

                <div class="nav-section-title mt-3">Laporan & Arsip</div>
                <a class="sidebar-link @(currentPath.StartsWith("/Reports") ? "active" : "")" asp-page="/Reports/Index">
                    <i data-lucide="file-text" style="width: 18px; height: 18px;"></i>
                    <span>Laporan Absensi</span>
                </a>

                <div class="nav-section-title mt-3">Sistem</div>
                <a class="sidebar-link @(currentPath.StartsWith("/Settings") ? "active" : "")" asp-page="/Settings/Index">
                    <i data-lucide="sliders" style="width: 18px; height: 18px;"></i>
                    <span>Pengaturan & Backup</span>
                </a>
            </nav>

            <div class="sidebar-footer">
                <div class="d-flex align-items-center justify-content-between">
                    <div class="text-truncate me-2">
                        <div class="text-white text-truncate" style="font-size: 0.8rem; font-weight: 600;">@displayName</div>
                        <div style="font-size: 0.7rem; color: #94A3B8;">Leader / Administrator</div>
                    </div>
                    <form method="post" asp-page="/Account/Logout" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-outline-light p-1" title="Logout" style="border-color: rgba(255,255,255,0.2);">
                            <i data-lucide="log-out" style="width: 15px; height: 15px;"></i>
                        </button>
                    </form>
                </div>
            </div>
        </aside>

        <!-- Mobile Sidebar Backdrop Overlay -->
        <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

        <!-- Main Content -->
        <div class="app-main">
            <!-- Topbar -->
            <header class="app-topbar">
                <div class="d-flex align-items-center gap-2 gap-md-3">
                    <button class="btn btn-sm d-lg-none p-1 text-dark border" id="sidebarToggle" type="button" aria-label="Toggle menu">
                        <i data-lucide="menu" style="width: 20px; height: 20px;"></i>
                    </button>
                    <div>
                        <div class="topbar-site-badge">
                            <span class="site-dot"></span>
                            <span>Site Rembang</span>
                        </div>
                    </div>
                    <div class="d-none d-md-block text-muted" style="font-size: 0.8rem; border-left: 1px solid #CBD5E1; padding-left: 0.75rem;">
                        Engineer On Site – Manage Service SIG
                    </div>
                </div>

                <div class="d-flex align-items-center gap-2 gap-md-3">
                    <a asp-page="/Attendance/Daily" class="btn btn-primary btn-sm d-none d-sm-inline-flex align-items-center gap-1 shadow-sm py-1 px-2" style="font-size: 0.78rem;">
                        <i data-lucide="plus-circle" style="width: 14px; height: 14px;"></i>
                        <span>Input Absen</span>
                    </a>

                    <div class="d-none d-lg-block text-end" style="line-height: 1.2;">
                        <div style="font-size: 0.78rem; font-weight: 600; color: #1E293B;">@DateTime.UtcNow.AddHours(7).ToString("dddd, dd MMMM yyyy", new System.Globalization.CultureInfo("id-ID"))</div>
                        <div style="font-size: 0.7rem; color: #64748B;">Zona Waktu: Asia/Jakarta (WIB)</div>
                    </div>

                    <div class="user-badge py-1 px-2">
                        <div class="user-avatar" style="width: 26px; height: 26px; font-size: 0.75rem;">
                            @(displayName.Length > 0 ? displayName.Substring(0, 1).ToUpper() : "V")
                        </div>
                        <div class="d-none d-md-block text-start">
                            <div style="font-size: 0.78rem; font-weight: 600; color: #0F172A;">@displayName</div>
                            <div style="font-size: 0.65rem; color: #64748B;">Site Leader</div>
                        </div>
                    </div>
                </div>
            </header>

            <!-- Page Content -->
            <main class="app-content">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 border-0 shadow-sm mb-3" role="alert" style="background-color: #ECFDF5; color: #065F46; border-left: 4px solid #10B981 !important;">
                        <i data-lucide="check-circle-2" style="width: 18px; height: 18px;"></i>
                        <div style="font-size: 0.875rem; font-weight: 500;">@TempData["SuccessMessage"]</div>
                        <button type="button" class="btn-close ms-auto p-2" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2 border-0 shadow-sm mb-3" role="alert" style="background-color: #FEF2F2; color: #991B1B; border-left: 4px solid #EF4444 !important;">
                        <i data-lucide="alert-circle" style="width: 18px; height: 18px;"></i>
                        <div style="font-size: 0.875rem; font-weight: 500;">@TempData["ErrorMessage"]</div>
                        <button type="button" class="btn-close ms-auto p-2" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @RenderBody()
            </main>

            <!-- Corporate Footer -->
            <footer class="px-3 px-md-4 py-2 bg-white border-top text-muted d-flex flex-wrap justify-content-between align-items-center" style="font-size: 0.75rem;">
                <div>
                    &copy; @DateTime.UtcNow.Year Manage Service SIG – Site Rembang. Leader: <strong>Vino Rifhendi Setiawan</strong>
                </div>
                <div class="d-none d-sm-block">
                    Single Source of Truth: <strong>PostgreSQL</strong> | .NET 10 LTS
                </div>
            </footer>
        </div>

        <!-- Mobile Bottom Navigation Bar (Fixed for Smartphones) -->
        <nav class="app-bottom-nav d-md-none">
            <a href="/" class="bottom-nav-item @(currentPath == "/" || currentPath == "/Index" ? "active" : "")">
                <i data-lucide="layout-dashboard"></i>
                <span>Beranda</span>
            </a>
            <a href="/Attendance/Daily" class="bottom-nav-item bottom-nav-highlight @(currentPath.StartsWith("/Attendance/Daily") ? "active" : "")">
                <div class="highlight-circle">
                    <i data-lucide="plus"></i>
                </div>
                <span>Input Absen</span>
            </a>
            <a href="/Attendance/Index" class="bottom-nav-item @(currentPath == "/Attendance" || (currentPath.StartsWith("/Attendance") && !currentPath.StartsWith("/Attendance/Daily")) ? "active" : "")">
                <i data-lucide="calendar-check"></i>
                <span>Riwayat</span>
            </a>
            <a href="/Reports/Index" class="bottom-nav-item @(currentPath.StartsWith("/Reports") ? "active" : "")">
                <i data-lucide="file-text"></i>
                <span>Laporan</span>
            </a>
            <button type="button" class="bottom-nav-item btn-toggle-mobile border-0 bg-transparent" id="mobileMenuBtn">
                <i data-lucide="menu"></i>
                <span>Lainnya</span>
            </button>
        </nav>
    }
    else
    {
        <!-- Minimal layout for unauthenticated pages (e.g. Login) -->
        <main>
            @RenderBody()
        </main>
    }

    <!-- Bootstrap 5 Bundle JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Inisialisasi ikon Lucide
        lucide.createIcons();

        // Mobile sidebar drawer & backdrop logic
        const toggleBtn = document.getElementById('sidebarToggle');
        const mobileMenuBtn = document.getElementById('mobileMenuBtn');
        const closeBtn = document.getElementById('sidebarCloseBtn');
        const sidebar = document.getElementById('appSidebar');
        const backdrop = document.getElementById('sidebarBackdrop');

        function toggleSidebar() {
            if (sidebar) sidebar.classList.toggle('show');
            if (backdrop) backdrop.classList.toggle('show');
        }

        function closeSidebar() {
            if (sidebar) sidebar.classList.remove('show');
            if (backdrop) backdrop.classList.remove('show');
        }

        if (toggleBtn) toggleBtn.addEventListener('click', toggleSidebar);
        if (mobileMenuBtn) mobileMenuBtn.addEventListener('click', toggleSidebar);
        if (closeBtn) closeBtn.addEventListener('click', closeSidebar);
        if (backdrop) backdrop.addEventListener('click', closeSidebar);
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
