@using Microsoft.AspNetCore.Identity
@using SiteAttendance.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@{
    var currentPath = Context.Request.Path.Value ?? "/";
    var currentUser = await UserManager.GetUserAsync(User);
    var displayName = currentUser?.FullName ?? User.Identity?.Name ?? "Vino Rifhendi Setiawan";
}
<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Site Attendance Management</title>
    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <!-- Site CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
</head>
<body>
    @if (SignInManager.IsSignedIn(User))
    {
        <!-- Sidebar Navigation -->
        <aside class="app-sidebar" id="appSidebar">
            <div class="sidebar-header">
                <div>
                    <div class="sidebar-brand-title">SITE ATTENDANCE</div>
                    <div class="sidebar-brand-sub">Manage Service SIG</div>
                </div>
            </div>

            <nav class="sidebar-nav">
                <div class="nav-section-title">Menu Utama</div>
                <a class="sidebar-link @(currentPath == "/" || currentPath == "/Index" ? "active" : "")" asp-page="/Index">
                    <i data-lucide="layout-dashboard" style="width: 18px; height: 18px;"></i>
                    <span>Dashboard</span>
                </a>

                <a class="sidebar-link @(currentPath.StartsWith("/Attendance") ? "active" : "")" asp-page="/Attendance/Index">
                    <i data-lucide="calendar-check" style="width: 18px; height: 18px;"></i>
                    <span>Data Absensi</span>
                </a>

                <a class="sidebar-link @(currentPath.StartsWith("/Employees") ? "active" : "")" asp-page="/Employees/Index">
                    <i data-lucide="users" style="width: 18px; height: 18px;"></i>
                    <span>Kelola Engineer</span>
                </a>

                <div class="nav-section-title mt-3">Laporan & Arsip</div>
                <a class="sidebar-link @(currentPath.StartsWith("/Reports") ? "active" : "")" asp-page="/Reports/Index">
                    <i data-lucide="file-text" style="width: 18px; height: 18px;"></i>
                    <span>Laporan Absensi</span>
                </a>

                <div class="nav-section-title mt-3">Sistem</div>
                <a class="sidebar-link @(currentPath.StartsWith("/Settings") ? "active" : "")" asp-page="/Settings/Index">
                    <i data-lucide="sliders" style="width: 18px; height: 18px;"></i>
                    <span>Pengaturan & Backup</span>
                </a>
            </nav>

            <div class="sidebar-footer">
                <div class="d-flex align-items-center justify-content-between">
                    <div class="text-truncate me-2">
                        <div class="text-white text-truncate" style="font-size: 0.8rem; font-weight: 600;">@displayName</div>
                        <div style="font-size: 0.7rem; color: #94A3B8;">Leader / Administrator</div>
                    </div>
                    <form method="post" asp-page="/Account/Logout" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-outline-light p-1" title="Logout" style="border-color: rgba(255,255,255,0.2);">
                            <i data-lucide="log-out" style="width: 15px; height: 15px;"></i>
                        </button>
                    </form>
                </div>
            </div>
        </aside>

        <!-- Main Content -->
        <div class="app-main">
            <!-- Topbar -->
            <header class="app-topbar">
                <div class="d-flex align-items-center gap-3">
                    <button class="btn btn-sm d-lg-none p-0 text-dark" id="sidebarToggle" type="button">
                        <i data-lucide="menu" style="width: 24px; height: 24px;"></i>
                    </button>
                    <div>
                        <div class="topbar-site-badge">
                            <span class="site-dot"></span>
                            <span>Site Rembang</span>
                        </div>
                    </div>
                    <div class="d-none d-md-block text-muted" style="font-size: 0.8rem; border-left: 1px solid #CBD5E1; padding-left: 0.75rem;">
                        Engineer On Site – Manage Service SIG
                    </div>
                </div>

                <div class="d-flex align-items-center gap-3">
                    <div class="d-none d-sm-block text-end" style="line-height: 1.2;">
                        <div style="font-size: 0.78rem; font-weight: 600; color: #1E293B;">@DateTime.UtcNow.AddHours(7).ToString("dddd, dd MMMM yyyy", new System.Globalization.CultureInfo("id-ID"))</div>
                        <div style="font-size: 0.7rem; color: #64748B;">Zona Waktu: Asia/Jakarta (WIB)</div>
                    </div>

                    <div class="user-badge">
                        <div class="user-avatar">
                            @(displayName.Length > 0 ? displayName.Substring(0, 1).ToUpper() : "V")
                        </div>
                        <div class="d-none d-md-block text-start">
                            <div style="font-size: 0.8rem; font-weight: 600; color: #0F172A;">@displayName</div>
                            <div style="font-size: 0.68rem; color: #64748B;">Site Leader</div>
                        </div>
                    </div>
                </div>
            </header>

            <!-- Page Content -->
            <main class="app-content">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 border-0 shadow-sm mb-3" role="alert" style="background-color: #ECFDF5; color: #065F46; border-left: 4px solid #10B981 !important;">
                        <i data-lucide="check-circle-2" style="width: 18px; height: 18px;"></i>
                        <div style="font-size: 0.875rem; font-weight: 500;">@TempData["SuccessMessage"]</div>
                        <button type="button" class="btn-close ms-auto p-2" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2 border-0 shadow-sm mb-3" role="alert" style="background-color: #FEF2F2; color: #991B1B; border-left: 4px solid #EF4444 !important;">
                        <i data-lucide="alert-circle" style="width: 18px; height: 18px;"></i>
                        <div style="font-size: 0.875rem; font-weight: 500;">@TempData["ErrorMessage"]</div>
                        <button type="button" class="btn-close ms-auto p-2" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @RenderBody()
            </main>

            <!-- Corporate Footer -->
            <footer class="px-4 py-2 bg-white border-top text-muted d-flex flex-wrap justify-content-between align-items-center" style="font-size: 0.75rem;">
                <div>
                    &copy; @DateTime.UtcNow.Year Manage Service SIG – Site Rembang. Administrator: <strong>Vino Rifhendi Setiawan</strong>
                </div>
                <div>
                    Single Source of Truth: <strong>PostgreSQL</strong> | .NET 10 LTS
                </div>
            </footer>
        </div>
    }
    else
    {
        <!-- Minimal layout for unauthenticated pages (e.g. Login) -->
        <main>
            @RenderBody()
        </main>
    }

    <!-- Bootstrap 5 Bundle JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Inisialisasi ikon Lucide
        lucide.createIcons();

        // Mobile sidebar toggle
        const toggleBtn = document.getElementById('sidebarToggle');
        const sidebar = document.getElementById('appSidebar');
        if (toggleBtn && sidebar) {
            toggleBtn.addEventListener('click', () => {
                sidebar.classList.toggle('show');
            });
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
