# =====================================================================
# SITE ATTENDANCE MANAGEMENT SYSTEM - ENVIRONMENT CONFIGURATION
# Manage Service SIG - Site Rembang
# =====================================================================

# ASP.NET Core Environment
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080

# PostgreSQL Connection String (Single Source of Truth)
# Format 1: Standar ADO.NET Npgsql Connection String
ConnectionStrings__DefaultConnection=Host=your-postgres-host.com;Port=5432;Database=site_attendance_db;Username=postgres;Password=YourSecurePassword123!;SSL Mode=Require;Trust Server Certificate=true

# Format 2: Cloud Managed Provider URI (Neon, Supabase, Railway, Render, ElephantSQL)
DATABASE_URL=postgresql://postgres:YourSecurePassword123!@ep-xyz-pooler.ap-southeast-1.aws.neon.tech/site_attendance_db?sslmode=require

# Administrator Initial Setup
ADMIN_INITIAL_PASSWORD=AdminSite2026!

